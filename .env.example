# TradePilot 环境变量示例。复制为 .env 后填写真实值；.env 不进入 Git。

# development / testing / production
TRADEPILOT_ENVIRONMENT=development

# PostgreSQL 连接串（与 compose.yaml 中的配置对应）
TRADEPILOT_DATABASE_URL=postgresql+psycopg://tradepilot:tradepilot@localhost:5432/tradepilot

# 阶段六：大模型辅助提取（默认关闭；启用前请确认数据授权，真实企业数据未经授权不得发第三方 API）
# TRADEPILOT_AI_ENABLED=true
# TRADEPILOT_AI_BASE_URL=https://api.deepseek.com/v1
# TRADEPILOT_AI_API_KEY=sk-xxxx
# TRADEPILOT_AI_MODEL=deepseek-chat
