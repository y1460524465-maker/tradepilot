# TradePilot 环境变量示例。复制为 .env 后填写真实值；.env 不进入 Git。

# development / testing / production
TRADEPILOT_ENVIRONMENT=development

# PostgreSQL 连接串（阶段二启用，与 compose.yaml 中的配置对应）
TRADEPILOT_DATABASE_URL=postgresql+psycopg://tradepilot:tradepilot@localhost:5432/tradepilot

# 阶段六启用：大模型 API（DeepSeek，OpenAI 兼容接口）
# DEEPAI_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
